.env
.env.*
!.env.example
*.log
.DS_Store

.fp/
_scratch/

# Machine output: logs, build junk, agent working files. Deletable at any
# instant — `sh scripts/clean-tmp.sh` empties it.
tmp/

# Python bytecode: importing a scripts/*.py module rewrites it on every run.
__pycache__/
*.py[cod]

# Agent settings live at user level, as in the other fleet repositories.
.claude/

# Heavy artifacts — never commit (a big blob bloats .git history even after deletion).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.faiss
*.npy
*.npz
vectors/

.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
*.Rcheck/
*.tar.gz
src/*.o
src/*.so
src/*.dll
vignettes/*.html
vignettes/*.pdf
site/
public/
.r-lib/
.pak-cache/
doc/
Meta/
tests/testthat/_snaps/
