{
  "permissions": {
    "allow": [
      "Bash(fp:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.RData)",
      "Read(./.Rhistory)",
      "Read(./.Rproj.user/**)",
      "Read(./lib/**)"
    ]
  }
}
